{
  "name": "redblue-live",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "RED vs BLUE — TikTok LIVE game (web page captured by OBS)",
  "engines": { "node": ">=22" },
  "scripts": {
    "start": "node --env-file-if-exists=.env server/index.js",
    "sim": "node tools/sim-cli.mjs",
    "test": "node --test \"test/unit/*.test.js\"",
    "test:api": "node --test \"test/api/*.test.js\"",
    "bridge": "node --env-file-if-exists=.env adapters/bridge.mjs",
    "assets": "node tools/fetch-assets.mjs"
  },
  "dependencies": { "pg": "^8.13.0" },
  "optionalDependencies": { "tiktok-live-connector": "^2.0.0" }
}
