# Copy to .env (never commit it). Used by `npm start` (server) and `npm run bridge`.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require   # Neon / any Postgres
OPERATOR_TOKEN=change-me-long-random      # protects /operator.html and /api/operator/*
CHANNEL_TOKEN=change-me-another-random    # used by the game page (?token=) and the bridge
PORT=3000
# --- bridge only (runs on the streamer's PC) ---
TIKTOK_USER=yourtiktokname
SERVER_URL=http://localhost:3000
# EULER_SIGN_API_KEY=                     # optional: sign-server key for tiktok-live-connector (rate limits are lower without one)
